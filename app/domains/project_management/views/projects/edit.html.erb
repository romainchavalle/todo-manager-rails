<div class="page-header">
  <div>
    <h1 class="page-title">Modifier le projet</h1>
    <p class="page-subtitle">Mettez à jour les informations, la couleur ou archivez ce projet.</p>
  </div>

  <% if policy(@project).destroy? %>
    <%= button_to project_path(@project), method: :delete, data: { turbo_confirm: "Êtes-vous sûr de vouloir supprimer ce projet ? Les tâches associées seront conservées sans projet." }, class: "btn btn-filter-reset", style: "color: var(--danger); border: 1px solid var(--danger-border); background-color: var(--danger-bg);" do %>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
        <path d="M3 6h18"/>
        <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
        <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
      </svg>
      Supprimer le projet
    <% end %>
  <% end %>
</div>

<div class="auth-card" style="max-width: 640px; margin: 0 auto;">
  <%= render "form", project: @project %>
</div>
