<div class="page-header">
  <div>
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
      <%= link_to "← Tous les projets", projects_path, style: "color: var(--text-muted); font-size: 0.88rem; text-decoration: none;" %>
    </div>
    <div style="display: flex; align-items: center; gap: 12px;">
      <span style="display: inline-block; width: 14px; height: 14px; border-radius: 50%; background-color: <%= @project.color %>;"></span>
      <h1 class="page-title" style="margin: 0;"><%= @project.name %></h1>
      <%= project_status_badge(@project) %>
    </div>
  </div>

  <% if policy(@project).update? %>
    <div style="display: flex; gap: 10px;">
      <%= link_to edit_project_path(@project), class: "btn btn-filter-reset", style: "border: 1px solid var(--border);" do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
          <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
        </svg>
        Modifier le projet
      <% end %>

      <% if policy(Task).create? %>
        <%= link_to new_task_path(project_id: @project.id), class: "btn btn-primary" do %>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          Ajouter une tâche
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

<div class="project-banner">
  <div class="project-banner-stripe" style="background-color: <%= @project.color %>;"></div>

  <% if @project.description.present? %>
    <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0 0 20px 0; line-height: 1.5;"><%= @project.description %></p>
  <% end %>

  <div class="project-card-progress" style="max-width: 480px; margin-bottom: 20px;">
    <div class="progress-header">
      <span>Taux de complétion</span>
      <span style="font-weight: 700; color: var(--text-main);"><%= @project.completion_percentage %>%</span>
    </div>
    <div class="progress-bar-track" style="height: 8px;">
      <div class="progress-bar-fill" style="width: <%= @project.completion_percentage %>%; background-color: <%= @project.color %>;"></div>
    </div>
  </div>

  <div class="project-metrics-grid">
    <div class="project-metric-card">
      <div class="project-metric-value"><%= @project.total_tasks_count %></div>
      <div class="project-metric-label">Tâches totales</div>
    </div>
    <div class="project-metric-card">
      <div class="project-metric-value" style="color: #16a34a;"><%= @project.completed_tasks_count %></div>
      <div class="project-metric-label">Terminées</div>
    </div>
    <div class="project-metric-card">
      <div class="project-metric-value" style="color: #2563eb;"><%= @project.pending_tasks_count %></div>
      <div class="project-metric-label">Restantes</div>
    </div>
  </div>
</div>

<div style="margin-top: 32px;">
  <h2 style="font-size: 1.2rem; font-weight: 700; color: var(--text-main); margin-bottom: 16px;">Tâches du projet</h2>

  <% if @tasks.any? %>
    <div class="tasks-container">
      <%= render @tasks %>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state-icon">📋</div>
      <h3 class="empty-state-title">Aucune tâche dans ce projet</h3>
      <p class="empty-state-text">Ce projet ne contient aucune tâche pour le moment.</p>
      <% if policy(Task).create? %>
        <%= link_to "Créer une première tâche", new_task_path(project_id: @project.id), class: "btn btn-primary" %>
      <% end %>
    </div>
  <% end %>
</div>
