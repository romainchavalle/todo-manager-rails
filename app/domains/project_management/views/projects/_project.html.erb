<%= link_to project_path(project), class: "project-card", data: { turbo_frame: "_top" } do %>
  <div class="project-card-stripe" style="background-color: <%= project.color %>;"></div>

  <div>
    <div class="project-card-header">
      <h3 class="project-card-title"><%= project.name %></h3>
      <%= project_status_badge(project) %>
    </div>

    <% if project.description.present? %>
      <p class="project-card-desc"><%= project.description %></p>
    <% end %>
  </div>

  <div class="project-card-progress">
    <div class="progress-header">
      <span>Avancement</span>
      <span><%= project.completion_percentage %>%</span>
    </div>
    <div class="progress-bar-track">
      <div class="progress-bar-fill" style="width: <%= project.completion_percentage %>%; background-color: <%= project.color %>;"></div>
    </div>
  </div>

  <div class="project-card-footer">
    <span class="project-stats-badge">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="18" height="18" x="3" y="3" rx="2"/>
        <path d="m9 12 2 2 4-4"/>
      </svg>
      <%= pluralize(project.total_tasks_count, "tâche") %>
    </span>

    <div style="display: flex; align-items: center; gap: 6px;" title="Créé par <%= project.creator.full_name %>">
      <span class="user-avatar" style="width: 22px; height: 22px; font-size: 0.65rem;"><%= user_initials(project.creator) %></span>
      <span><%= project.creator.first_name %></span>
    </div>
  </div>
<% end %>
