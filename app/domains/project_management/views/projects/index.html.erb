<div class="page-header">
  <div>
    <h1 class="page-title">Projets</h1>
    <p class="page-subtitle">
      <% if policy(Project).create? %>
        Pilotez les projets de l'équipe et suivez l'avancement global.
      <% else %>
        Consultez les projets actifs et les tâches qui vous sont confiées.
      <% end %>
    </p>
  </div>

  <% if policy(Project).create? %>
    <%= link_to new_project_path, class: "btn btn-primary" do %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      Nouveau Projet
    <% end %>
  <% end %>
</div>

<%= form_with url: projects_path, method: :get, data: { controller: "filter", turbo_frame: "projects_list" }, class: "filter-bar" do |f| %>
  <%= f.text_field :q, value: params[:q], placeholder: "Rechercher un projet...", class: "filter-search-input", data: { action: "input->filter#search" } %>

  <% if policy(Project).create? %>
    <%= f.select :status, options_for_select([["Tous les statuts", ""]] + project_status_options, params[:status]), {}, class: "filter-select", data: { action: "change->filter#submit" } %>
  <% end %>

  <button type="button" class="btn-filter-reset" data-filter-target="resetButton" data-action="click->filter#reset" style="display: none;">
    ✕ Réinitialiser
  </button>
<% end %>

<%= turbo_frame_tag "projects_list" do %>
  <% if @projects.any? %>
    <div class="projects-grid">
      <%= render @projects %>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state-icon">📁</div>
      <h3 class="empty-state-title">Aucun projet trouvé</h3>
      <p class="empty-state-text">
        <% if params[:q].present? || params[:status].present? %>
          Aucun projet ne correspond à vos filtres actuels.
        <% else %>
          Aucun projet n'est disponible pour le moment.
        <% end %>
      </p>
      <% if policy(Project).create? %>
        <%= link_to "Créer un projet", new_project_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  <% end %>
<% end %>
