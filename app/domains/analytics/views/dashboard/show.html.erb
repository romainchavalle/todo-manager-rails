<div class="page-header">
  <div>
    <h1 class="page-title">Tableau de bord</h1>
    <p class="page-subtitle">Pilotez la charge de l'équipe, la santé des projets et les priorités en cours.</p>
  </div>
</div>

<div class="dashboard-kpi-grid">
  <div class="dashboard-kpi-card">
    <div class="dashboard-kpi-icon" style="background-color: #eff6ff; color: #2563eb;">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="18" height="18" x="3" y="3" rx="2"/>
        <path d="m9 12 2 2 4-4"/>
      </svg>
    </div>
    <div>
      <div class="dashboard-kpi-value"><%= @active_tasks.size %></div>
      <div class="dashboard-kpi-label">Tâches actives</div>
    </div>
  </div>

  <div class="dashboard-kpi-card">
    <div class="dashboard-kpi-icon" style="background-color: #fef2f2; color: #dc2626;">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
        <line x1="12" y1="9" x2="12" y2="13"/>
        <line x1="12" y1="17" x2="12.01" y2="17"/>
      </svg>
    </div>
    <div>
      <div class="dashboard-kpi-value" style="color: #dc2626;"><%= @priority_tasks.size %></div>
      <div class="dashboard-kpi-label">Tâches urgentes / prioritaires</div>
    </div>
  </div>

  <div class="dashboard-kpi-card">
    <div class="dashboard-kpi-icon" style="background-color: #f5f3ff; color: #7c3aed;">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
      </svg>
    </div>
    <div>
      <div class="dashboard-kpi-value" style="color: #7c3aed;"><%= @total_remaining_effort %> <span style="font-size: 0.9rem; font-weight: 500; color: var(--text-muted);">pts</span></div>
      <div class="dashboard-kpi-label">Volume d'effort restant</div>
    </div>
  </div>
</div>

<div class="dashboard-main-grid">
  <div class="dashboard-section-card">
    <div class="dashboard-section-header">
      <div>
        <h2 class="dashboard-section-title">Charge par Collaborateur</h2>
        <p class="dashboard-section-desc">Répartition de l'effort actif par membre de l'équipe.</p>
      </div>
    </div>

    <div class="workload-list">
      <% @employees.each do |employee| %>
        <% active_tasks_count = employee_active_tasks(employee).size %>
        <% effort_points = employee_effort_points(employee) %>

        <div class="workload-item">
          <div class="workload-item-header">
            <div style="display: flex; align-items: center; gap: 10px;">
              <span class="user-avatar" style="width: 32px; height: 32px; font-size: 0.8rem;"><%= user_initials(employee) %></span>
              <div>
                <div style="font-weight: 600; color: var(--text-main); font-size: 0.92rem;"><%= employee.full_name %></div>
                <div style="font-size: 0.78rem; color: var(--text-muted);"><%= pluralize(active_tasks_count, "tâche active", "tâches actives") %></div>
              </div>
            </div>

            <%= employee_workload_badge(effort_points) %>
          </div>

          <div class="workload-bar-track">
            <% bar_width = [[(effort_points.to_f / 10 * 100), 100].min, 4].max %>
            <% bar_color = effort_points >= 8 ? "#ef4444" : (effort_points >= 4 ? "#f59e0b" : "#10b981") %>
            <div class="workload-bar-fill" style="width: <%= bar_width %>%; background-color: <%= bar_color %>;"></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="dashboard-section-card">
    <div class="dashboard-section-header">
      <div>
        <h2 class="dashboard-section-title">Santé des Projets</h2>
        <p class="dashboard-section-desc">Avancement pondéré par les points d'effort réels.</p>
      </div>
      <%= link_to "Tous les projets →", projects_path, style: "font-size: 0.82rem; font-weight: 600; color: var(--text-muted); text-decoration: none;" %>
    </div>

    <div class="dashboard-projects-list">
      <% if @projects.any? %>
        <% @projects.each do |project| %>
          <%= link_to project_path(project), class: "dashboard-project-item" do %>
            <div class="dashboard-project-header">
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="width: 10px; height: 10px; border-radius: 50%; background-color: <%= project.color %>;"></span>
                <span style="font-weight: 600; color: var(--text-main); font-size: 0.92rem;"><%= project.name %></span>
              </div>
              <span style="font-weight: 700; color: var(--text-main); font-size: 0.88rem;"><%= project.completion_percentage %>%</span>
            </div>

            <div class="progress-bar-track" style="height: 6px; margin: 8px 0 6px 0;">
              <div class="progress-bar-fill" style="width: <%= project.completion_percentage %>%; background-color: <%= project.color %>;"></div>
            </div>

            <div style="display: flex; justify-content: space-between; font-size: 0.78rem; color: var(--text-muted);">
              <span><%= project.completed_effort_points %> / <%= project.total_effort_points %> pts complétés</span>
              <span><%= project.pending_tasks_count %> restante(s)</span>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <p style="color: var(--text-muted); font-size: 0.88rem; text-align: center; padding: 20px 0;">Aucun projet actif.</p>
      <% end %>
    </div>
  </div>
</div>

<div class="dashboard-section-card" style="margin-top: 24px;">
  <div class="dashboard-section-header">
    <div>
      <h2 class="dashboard-section-title">Tâches Prioritaires en Attente</h2>
      <p class="dashboard-section-desc">Tâches urgentes et hautes actives nécessitant une vigilance managériale.</p>
    </div>
    <%= link_to "Voir toutes les tâches →", tasks_path, style: "font-size: 0.82rem; font-weight: 600; color: var(--text-muted); text-decoration: none;" %>
  </div>

  <% if @priority_tasks.any? %>
    <div class="tasks-container">
      <%= render @priority_tasks %>
    </div>
  <% else %>
    <div class="empty-state" style="padding: 36px 20px;">
      <div class="empty-state-icon" style="font-size: 2rem;">🎉</div>
      <h3 class="empty-state-title" style="font-size: 1rem;">Aucune tâche critique en attente</h3>
      <p class="empty-state-text" style="font-size: 0.85rem; margin-bottom: 0;">Toutes les tâches urgentes ou prioritaires sont terminées.</p>
    </div>
  <% end %>
</div>
