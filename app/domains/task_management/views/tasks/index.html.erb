<div class="page-header">
  <div>
    <h1 class="page-title">Gestion des Tâches</h1>
    <p class="page-subtitle">
      <% if current_user.manager? %>
        Supervisez et assignez les tâches de l'ensemble de l'équipe.
      <% else %>
        Consultez et mettez à jour vos tâches assignées.
      <% end %>
    </p>
  </div>

  <% if policy(Task).create? %>
    <%= link_to new_task_path, class: "btn btn-primary" do %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      Nouvelle Tâche
    <% end %>
  <% end %>
</div>

<%= form_with url: tasks_path, method: :get, data: { controller: "tasks-filter", turbo_frame: "tasks_list" }, class: "tasks-filter-bar" do |f| %>
  <%= f.text_field :q, value: params[:q], placeholder: "Rechercher une tâche...", class: "filter-search-input", data: { action: "input->tasks-filter#search" } %>

  <%= f.select :status, options_for_select([["Tous les statuts", ""]] + task_status_options, params[:status]), {}, class: "filter-select", data: { action: "change->tasks-filter#submit" } %>

  <%= f.select :priority, options_for_select([["Toutes les priorités", ""]] + task_priority_options, params[:priority]), {}, class: "filter-select", data: { action: "change->tasks-filter#submit" } %>

  <% if @projects.any? %>
    <%= f.select :project_id, options_for_select([["Tous les projets", ""]] + @projects.map { |p| [p.name, p.id] }, params[:project_id]), {}, class: "filter-select", data: { action: "change->tasks-filter#submit" } %>
  <% end %>

  <% if policy(User).index? && @users.any? %>
    <%= f.select :assignee_id, options_for_select([["Tous les assignés", ""]] + @users.map { |u| [u.full_name, u.id] }, params[:assignee_id]), {}, class: "filter-select", data: { action: "change->tasks-filter#submit" } %>
  <% end %>

  <button type="button" class="btn-filter-reset" data-tasks-filter-target="resetButton" data-action="click->tasks-filter#reset" style="display: none; border: none; background: none; cursor: pointer;">
    ✕ Réinitialiser
  </button>
<% end %>

<%= turbo_frame_tag "tasks_list" do %>
  <% if @tasks.any? %>
    <div class="tasks-container">
      <%= render @tasks %>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state-icon">📋</div>
      <h3 class="empty-state-title">Aucune tâche trouvée</h3>
      <p class="empty-state-text">
        Aucune tâche ne correspond à vos filtres actuels.
      </p>
      <% if policy(Task).create? %>
        <%= link_to "Créer une tâche", new_task_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  <% end %>
<% end %>
