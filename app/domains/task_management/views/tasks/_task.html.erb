<%= turbo_frame_tag dom_id(task) do %>
  <div class="task-card">
    <div class="task-main">
      <% if policy(task).update? %>
        <%= button_to change_status_task_path(task, status: task.completed? ? "todo" : "completed"), method: :patch, class: "task-status-btn", title: task.completed? ? "Marquer à faire" : "Marquer terminée" do %>
          <% if task.completed? %>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="#16a34a" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" fill="#dcfce7" stroke="#86efac"/>
              <polyline points="9 12 11 14 15 10" stroke="#16a34a"/>
            </svg>
          <% else %>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
            </svg>
          <% end %>
        <% end %>
      <% end %>

      <div class="task-details">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span class="task-title <%= "task-title--completed" if task.completed? %>"><%= task.title %></span>
          <%= task_priority_badge(task) %>
        </div>

        <% if task.description.present? %>
          <p class="task-description"><%= task.description %></p>
        <% end %>

        <div class="task-meta">
          <% if task.project %>
            <span class="project-pill" style="border-left: 3px solid <%= task.project.color %>;"><%= task.project.name %></span>
          <% end %>

          <%= task_status_badge(task) %>

          <% if task.assignee %>
            <div class="task-assignee" title="Assigné à <%= task.assignee.full_name %>">
              <span class="user-avatar" style="width: 20px; height: 20px; font-size: 0.65rem;"><%= user_initials(task.assignee) %></span>
              <span><%= task.assignee.full_name %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="task-actions">
      <% if policy(task).update? && current_user.manager? %>
        <%= link_to edit_task_path(task), class: "btn-icon", title: "Modifier", data: { turbo_frame: "_top" } do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
          </svg>
        <% end %>
      <% end %>

      <% if policy(task).destroy? %>
        <%= button_to task_path(task), method: :delete, data: { turbo_confirm: "Êtes-vous sûr de vouloir supprimer cette tâche ?" }, class: "btn-icon btn-icon-danger", title: "Supprimer" do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 6h18"/>
            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
