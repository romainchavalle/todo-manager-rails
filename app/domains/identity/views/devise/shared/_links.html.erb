<div class="auth-links">
  <%- if controller_name != 'sessions' %>
    <span>Déjà un compte ?</span> <%= link_to "Se connecter", new_session_path(resource_name), class: "auth-link" %><br />
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <span>Pas encore de compte ?</span> <%= link_to "Créer un compte", new_registration_path(resource_name), class: "auth-link" %><br />
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "Mot de passe oublié ?", new_password_path(resource_name), class: "auth-link-subtle" %><br />
  <% end %>
</div>
