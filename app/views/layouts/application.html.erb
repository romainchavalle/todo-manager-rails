<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || "TodoManager" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="app-layout <%= "app-layout--fullwidth" if content_for?(:no_sidebar) %>">
      <%= render "shared/sidebar" unless content_for?(:no_sidebar) %>

      <div class="app-content">
        <%= render "shared/flash" %>

        <main class="main-body">
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>