<div class="sidebar-user-card">
  <div class="user-avatar">
    <%= user_initials(current_user) %>
  </div>

  <div class="user-details">
    <span class="user-name" title="<%= current_user.full_name %>"><%= current_user.full_name %></span>
    <div class="user-badge-wrapper">
      <%= role_badge(current_user) %>
    </div>
  </div>

  <%= button_to destroy_user_session_path, method: :delete, data: { turbo: true }, class: "sidebar-logout-btn", title: "Se déconnecter" do %>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
      <polyline points="16 17 21 12 16 7"/>
      <line x1="21" x2="9" y1="12" y2="12"/>
    </svg>
  <% end %>
</div>